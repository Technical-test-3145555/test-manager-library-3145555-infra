# Copy to .env and change every value. The real .env is never committed (constitution, article IX).

# Database engine (empty on first start; the api migrations create the schema)
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# api
# production (default) or local. Only local accepts CLOCK_OFFSET_DAYS, used to seed overdue demo loans.
APP_ENV=production
# Generate it with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:replace-with-the-generated-key
CLOCK_OFFSET_DAYS=0
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGIN=http://localhost:5173
API_PORT=8080

# app
APP_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1

# Build contexts of the sibling repositories (default: next to this repository)
API_CONTEXT=../test-manager-library-3145555-api
APP_CONTEXT=../test-manager-library-3145555-app
